# Archon PRODUCT service — environment file
#
# Copy to /opt/archon-product/secrets/.env  (chmod 600, owned by the service user)
# and fill in. This is the MULTI-TENANT product, a separate service from the
# owner's personal bot — different data dir, different DB, different port.
#
# NOTE ON THE FILENAME: this file is `env.example`, not `.env.example`, because
# the repo's .gitignore has `.env.*` and would silently exclude it.
#
# Anything marked REQUIRED must be set or the service refuses to start
# (config.check_production_secrets fails closed — see PRODUCT_DEPLOY.md).

# =============================================================================
# REQUIRED — mode
# =============================================================================
# Turns on accounts, /auth/*, per-tenant scoping, rate limiting, and makes the
# owner's Telegram credentials optional. Without this the service boots as the
# single-user personal bot and will demand TELEGRAM_BOT_TOKEN/OWNER_ID.
MULTITENANT_ENABLED=true

# The HTTP API is the product. cloudflared connects to it over loopback.
API_ENABLED=true
# NEVER 0.0.0.0 on a public box: cloudflared reaches it on localhost, so the
# port must not be directly exposed.
API_BIND_HOST=127.0.0.1
# 8788, not 8787 — the personal bot already uses 8787 on this machine.
API_PORT=8788

# =============================================================================
# REQUIRED — secrets. Generate each with: openssl rand -hex 32
# The service REFUSES TO BOOT if any is unset or left at an in-repo default.
# =============================================================================
# Signs short-lived access JWTs.
JWT_SECRET=
# Peppers device-token, pair-code and refresh-token hashes.
API_TOKEN_PEPPER=
# Wraps every tenant's stored integration credential (Google refresh token,
# Telegram business connection, WhatsApp session). LOSING THIS MEANS EVERY
# TENANT MUST RE-LINK EVERY INTEGRATION — back it up with the database.
CREDENTIAL_ENCRYPTION_KEY=

# =============================================================================
# REQUIRED — paths (own directories; must NOT be shared with the personal bot)
# =============================================================================
ARCHON_DATA=/opt/archon-product/data
ARCHON_SECRETS=/opt/archon-product/secrets

# =============================================================================
# REQUIRED — one LLM provider key matching LLM_ACTIVE_PROVIDER
# =============================================================================
LLM_ACTIVE_PROVIDER=gemini
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# Per-day spend cap across ALL tenants (there is no per-tenant cap yet).
LLM_DAILY_BUDGET_USD=3.0

# =============================================================================
# Google (Gmail + Calendar) — required for the Google integration to work
# =============================================================================
# From a Google Cloud OAuth client of type "Web application".
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# CRITICAL: this must be the PUBLIC tunnel hostname + /integrations/google/callback
# and must match a redirect URI registered on that OAuth client EXACTLY —
# scheme, host, path, no trailing slash. Google compares it verbatim; a
# mismatch fails with redirect_uri_mismatch at consent time, not at boot.
GOOGLE_OAUTH_REDIRECT_URI=https://archon.example.com/integrations/google/callback

# =============================================================================
# Telegram product bot — required for the Telegram integration to work
# =============================================================================
# A SEPARATE bot from the owner's personal control bot, created via @BotFather.
# Users connect THIS bot as their Telegram Business chatbot.
PRODUCT_TELEGRAM_BOT_TOKEN=
# Its @handle without the @, used to build t.me deep links. If left blank the
# service fills it in from getMe at startup, but deep links issued before the
# first successful poll would be missing — set it explicitly.
TELEGRAM_BOT_USERNAME=

# =============================================================================
# Optional
# =============================================================================
TIMEZONE=Asia/Jerusalem
# Gmail is polled serially across all linked tenants on this interval.
GMAIL_POLL_SECONDS=90
# Sliding-window budgets (per minute). The auth one covers /auth/* and /pair,
# the credential-guessing surface.
# RATE_LIMIT_PER_IP_PER_MIN=120
# RATE_LIMIT_PER_TENANT_PER_MIN=300
# RATE_LIMIT_AUTH_PER_IP_PER_MIN=10
# Access/refresh token lifetimes.
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=30
# In multitenant mode this DEFAULTS TO FALSE so third-party message text is not
# written to a shared audit log. Only set it true if you have a retention story.
# AUDIT_STORE_CONTENT=false
# Self-hosted push. Leave empty to disable.
# NTFY_BASE_URL=
# NTFY_AUTH_TOKEN=

# =============================================================================
# DO NOT SET — owner-only, and setting them changes behaviour
# =============================================================================
# TELEGRAM_BOT_TOKEN / TELEGRAM_OWNER_ID  -> would start the owner's personal
#   control bot inside the product service.
# TELEGRAM_API_ID / TELEGRAM_API_HASH / TELETHON_SESSION -> the MTProto userbot
#   is the ToS-grey path and is deliberately not offered to product tenants.
# TG_LOG_CHANNEL_ID -> the owner's private log channel.
